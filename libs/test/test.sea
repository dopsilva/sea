-- libs/test/test.sea — a test framework for Sea (pure Sea)
--
-- Usage:
--   local t = require("sea/test")
--
--   t.describe("stack", function()
--       local s = nil
--       t.before_each(function() s = new_stack() end)
--       t.it("starts empty", function()
--           t.eq(s:size(), 0)
--       end)
--       t.it("pops what was pushed", function()
--           s:push(1)
--           t.eq(s:pop(), 1)
--       end)
--   end)
--
--   t.main()          -- run, print a report, exit with 1 if anything failed
--
-- An assertion that fails stops its test (the rest of the file goes on); a
-- runtime error or panic inside a test is reported as an error. Run a subset
-- with SEA_TEST=<text> (tests whose full name contains it) or t.run({filter = ...}).

local T = {}

-- ---- the tree of suites ------------------------------------------------------------

local function new_suite(name, parent)
    local s = {}
    s.name = name
    s.parent = parent
    s.items = [] -- tests and suites, in order
    s.before_each = []
    s.after_each = []
    s.before_all = []
    s.after_all = []
    s.skip = false
    return s
end

local root = new_suite("", nil)
local current = root
local has_only = false

local function add_test(name, fn, mode)
    if type(name) ~= "string" then panic("test: a test needs a name (string)") end
    local t = {}
    t.name = name
    t.fn = fn
    t.mode = mode -- "run", "skip", "only", "todo"
    t.suite = current
    current.items[] = t
    if mode == "only" then has_only = true end
end

-- t.describe(name, fn): a group of tests (groups nest)
function T.describe(name, fn)
    local s = new_suite(name, current)
    current.items[] = s
    local saved = current
    current = s
    fn()
    current = saved
end

-- t.describe_skip(name, fn): a group whose tests are all skipped
function T.describe_skip(name, fn)
    local saved = current
    T.describe(name, function()
        current.skip = true
        fn()
    end)
    current = saved
end

-- t.it(name, fn), t.skip(name, fn), t.only(name, fn), t.todo(name)
function T.it(name, fn) add_test(name, fn, "run") end
function T.skip(name, fn) add_test(name, fn, "skip") end
function T.only(name, fn) add_test(name, fn, "only") end
function T.todo(name) add_test(name, nil, "todo") end

local benches = []
local has_run = false

-- t.bench(name, fn): a benchmark. fn(b) runs the code b.n times (b.n grows
-- until a run takes about a second); b:reset() restarts the clock after
-- setup. Benchmarks run only when asked: t.run({bench = text}) or
-- SEA_BENCH=<text> (those whose full name contains it; "." for all).
function T.bench(name, fn)
    if type(name) ~= "string" then panic("test: a benchmark needs a name (string)") end
    local b = {}
    b.name = name
    b.fn = fn
    b.suite = current
    benches[] = b
end

-- hooks for the current group (and the groups inside it)
function T.before_each(fn) current.before_each[] = fn end
function T.after_each(fn) current.after_each[] = fn end
function T.before_all(fn) current.before_all[] = fn end
function T.after_all(fn) current.after_all[] = fn end

-- ---- showing values ------------------------------------------------------------------

local show

local function is_record(v)
    local ty = type(v)
    return ty == "table" or ty == "map" or ty == "struct"
end

local function is_list(v)
    local ty = type(v)
    return ty == "array" or ty == "int_array" or ty == "float_array" or ty == "float32_array"
end

local function sorted_keys(v)
    local keys = []
    for k, _ in v do keys[] = k end
    sort.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
    return keys
end

local function show_key(k)
    if type(k) == "string" and re.test("^[A-Za-z_][A-Za-z0-9_]*$", k) then return k end
    return "[" .. show(k, 1) .. "]"
end

show = function(v, depth)
    depth = depth or 0
    local ty = type(v)
    if ty == "string" then
        local s = string.replace(v, "\\", "\\\\")
        s = string.replace(s, "\"", "\\\"")
        s = string.replace(s, "\n", "\\n")
        s = string.replace(s, "\t", "\\t")
        return "\"" .. s .. "\""
    end
    if ty == "error" then return "error(" .. show(v.message, depth + 1) .. ")" end
    if is_list(v) then
        if depth > 3 then return "[...]" end
        local parts = []
        for i = 0, len(v) - 1 do
            if i >= 20 then
                parts[] = "... (" .. tostring(len(v)) .. " items)"
                break
            end
            parts[] = show(v[i], depth + 1)
        end
        return "[" .. string.join(parts, ", ") .. "]"
    end
    if is_record(v) then
        if depth > 3 then return "{...}" end
        local parts = []
        local keys = sorted_keys(v)
        for i = 0, len(keys) - 1 do
            if i >= 20 then
                parts[] = "..."
                break
            end
            parts[] = show_key(keys[i]) .. " = " .. show(v[keys[i]], depth + 1)
        end
        return "{" .. string.join(parts, ", ") .. "}"
    end
    return tostring(v)
end

T.show = show

-- ---- deep equality ---------------------------------------------------------------------

-- The path to the first difference between a and b, or nil when equal.
local function diff(a, b, path, depth)
    if a == b then return nil end
    if depth > 100 then return nil end
    if is_list(a) and is_list(b) then
        if len(a) ~= len(b) then
            return path .. " (length " .. tostring(len(b)) .. " vs " .. tostring(len(a)) .. ")"
        end
        for i = 0, len(a) - 1 do
            local d = diff(a[i], b[i], path .. "[" .. tostring(i) .. "]", depth + 1)
            if d ~= nil then return d end
        end
        return nil
    end
    if is_record(a) and is_record(b) then
        for k, va in a do
            local d = diff(va, b[k], path .. "." .. show_key(k), depth + 1)
            if d ~= nil then return d end
        end
        for k, vb in b do
            if a[k] == nil and vb ~= nil then return path .. "." .. show_key(k) end
        end
        return nil
    end
    if type(a) == "error" and type(b) == "error" then
        if a.message == b.message then return nil end
    end
    return path
end

-- t.equal(a, b) → bool: deep equality (lists element by element; tables,
-- maps and structs by keys and values; 1 == 1.0 as in Sea)
function T.equal(a, b)
    return diff(a, b, "", 0) == nil
end

-- ---- assertions --------------------------------------------------------------------------

local function failure(msg, user)
    local f = {}
    f.__test_failure = true
    f.message = user ~= nil and (tostring(user) .. ": " .. msg) or msg
    panic(f)
end

-- t.fail([msg])
function T.fail(msg)
    failure("failed", msg)
end

-- t.eq(got, want [, msg]): deep equality
function T.eq(got, want, msg)
    local d = diff(want, got, "", 0)
    if d == nil then return got end
    local where = ""
    if d ~= "" then
        local p = d
        if string.starts_with(p, ".") then p = string.sub(p, 2) end
        where = "\n    at " .. p
    end
    failure("not equal" .. where .. "\n    expected: " .. show(want) .. "\n         got: " .. show(got), msg)
end

-- t.ne(got, other [, msg])
function T.ne(got, other, msg)
    if T.equal(got, other) then failure("expected a value different from " .. show(other), msg) end
    return got
end

-- t.ok(v [, msg]): v is truthy (not nil or false)
function T.ok(v, msg)
    if not v then failure("expected a truthy value, got " .. show(v), msg) end
    return v
end

-- t.no(v [, msg]): v is nil or false
function T.no(v, msg)
    if v then failure("expected nil or false, got " .. show(v), msg) end
    return v
end

function T.is_nil(v, msg)
    if v ~= nil then failure("expected nil, got " .. show(v), msg) end
end

function T.not_nil(v, msg)
    if v == nil then failure("expected a value, got nil", msg) end
    return v
end

-- t.near(got, want [, eps [, msg]]): |got - want| <= eps (default 1e-9 relative)
function T.near(got, want, eps, msg)
    if type(got) ~= "int" and type(got) ~= "number" then failure("expected a number, got " .. show(got), msg) end
    local tol = eps
    if tol == nil then tol = 1e-9 * math.max(1, math.abs(want)) end
    if math.abs(got - want) > tol then
        failure("expected " .. tostring(want) .. " ± " .. tostring(tol) .. ", got " .. tostring(got), msg)
    end
    return got
end

local function compare(op, got, bound, msg)
    local good = false
    if op == ">" then
        good = got > bound
    elseif op == ">=" then
        good = got >= bound
    elseif op == "<" then
        good = got < bound
    else
        good = got <= bound
    end
    if not good then failure("expected a value " .. op .. " " .. show(bound) .. ", got " .. show(got), msg) end
    return got
end

function T.gt(got, bound, msg) return compare(">", got, bound, msg) end
function T.ge(got, bound, msg) return compare(">=", got, bound, msg) end
function T.lt(got, bound, msg) return compare("<", got, bound, msg) end
function T.le(got, bound, msg) return compare("<=", got, bound, msg) end

-- t.contains(haystack, needle [, msg]): a substring, a list element or a record value
function T.contains(hay, needle, msg)
    if type(hay) == "string" then
        if type(needle) == "string" and string.contains(hay, needle) then return hay end
    elseif is_list(hay) then
        for _, v in hay do
            if T.equal(v, needle) then return hay end
        end
    elseif is_record(hay) then
        for _, v in hay do
            if T.equal(v, needle) then return hay end
        end
    end
    failure(show(hay) .. " does not contain " .. show(needle), msg)
end

-- t.matches(s, pattern [, msg]): s matches the regular expression (module re)
function T.matches(s, pattern, msg)
    if type(s) ~= "string" or not re.test(pattern, s) then
        failure(show(s) .. " does not match /" .. pattern .. "/", msg)
    end
    return s
end

-- t.is_error(v [, text [, msg]]): v is an error value (whose message contains text)
function T.is_error(v, text, msg)
    if not is_error(v) then failure("expected an error value, got " .. show(v), msg) end
    if text ~= nil and not string.contains(v.message, text) then
        failure("error message " .. show(v.message) .. " does not contain " .. show(text), msg)
    end
    return v
end

-- t.no_error(v [, msg]) → v: v is not an error value
function T.no_error(v, msg)
    if is_error(v) then failure("unexpected error: " .. v.message, msg) end
    return v
end

-- Run fn, returning what it panicked with (nil if it returned).
local function catch(fn)
    local caught = nil
    local panicked = false
    local function run()
        defer function()
            local p = recover()
            if p ~= nil then
                caught = p
                panicked = true
            end
        end
        fn()
    end
    run()
    return panicked, caught
end

local function panic_text(p)
    if is_error(p) then return p.message end
    if type(p) == "table" and p.__test_failure then return p.message end
    return tostring(p)
end

-- t.raises(fn [, text [, msg]]) → message: fn panics (with a message containing text)
function T.raises(fn, text, msg)
    local panicked, p = catch(fn)
    if not panicked then failure("expected a panic", msg) end
    local m = panic_text(p)
    if text ~= nil and not string.contains(m, text) then
        failure("panic message " .. show(m) .. " does not contain " .. show(text), msg)
    end
    return m
end

-- ---- running --------------------------------------------------------------------------------

local function full_name(t)
    local parts = []
    parts[] = t.name
    local s = t.suite
    while s ~= nil and s.parent ~= nil do
        parts[] = s.name
        s = s.parent
    end
    local out = []
    for i = len(parts) - 1, 0, -1 do out[] = parts[i] end
    return string.join(out, " > ")
end

local function suite_chain(s)
    local chain = []
    while s ~= nil do
        chain[] = s
        s = s.parent
    end
    local out = []
    for i = len(chain) - 1, 0, -1 do out[] = chain[i] end -- outermost first
    return out
end

local function suite_skipped(s)
    while s ~= nil do
        if s.skip then return true end
        s = s.parent
    end
    return false
end

-- Run fn; nil if it went fine, else {kind = "fail" | "error", message}.
local function attempt(fn)
    local panicked, p = catch(fn)
    if not panicked then return nil end
    local r = {}
    if type(p) == "table" and p.__test_failure then
        r.kind = "fail"
        r.message = p.message
    else
        r.kind = "error"
        r.message = panic_text(p)
    end
    return r
end

-- Run one benchmark → ns per op, or nil and the problem
local function run_bench(item, budget)
    local b = {}
    b.n = 1
    local start = time.now()
    b.reset = function(self) start = time.now() end
    local elapsed = 0
    while true do
        start = time.now()
        local r = attempt(function() item.fn(b) end)
        if r ~= nil then return nil, r end
        elapsed = time.since(start)
        if elapsed >= budget or b.n >= 1000000000 then break end
        local grow = b.n * 100
        if elapsed > 0 then grow = math.floor(b.n * budget * 1.2 / elapsed) end
        if grow > b.n * 100 then grow = b.n * 100 end
        if grow <= b.n then grow = b.n + 1 end
        b.n = grow
    end
    return elapsed / b.n, nil, b.n
end

local function selected(t, filter)
    if has_only and t.mode ~= "only" then return false end
    if filter ~= nil and filter ~= "" and not string.contains(full_name(t), filter) then return false end
    return true
end

-- t.run([opts]) → {passed, failed, skipped, todo, total, ok, failures}
-- opts: filter (text in the full test name; default $SEA_TEST), format
-- ("pretty", "tap", "quiet"), timing (true: show each test's time), bench
-- (run the benchmarks whose name contains it, "." for all; default
-- $SEA_BENCH), benchtime (seconds per benchmark, default $SEA_BENCHTIME or 1).
-- res.benches: {name, n, ns_per_op} for each benchmark run.
function T.run(opts)
    opts = opts or {}
    local format = opts.format or "pretty"
    local filter = opts.filter or os.getenv("SEA_TEST")
    local timing = opts.timing
    if timing == nil then timing = true end
    local res = {}
    res.passed = 0
    res.failed = 0
    res.skipped = 0
    res.todo = 0
    res.failures = []
    local n = 0
    local t_start = time.now()

    local function say(line)
        if format ~= "quiet" then print(line) end
    end

    local function count_selected(s)
        local c = 0
        for _, item in s.items do
            if item.items ~= nil then
                c = c + count_selected(item)
            elseif selected(item, filter) then
                c = c + 1
            end
        end
        return c
    end

    local total_selected = count_selected(root)
    if format == "tap" then
        say("TAP version 13")
        say("1.." .. tostring(total_selected))
    end

    local function run_hooks(list)
        for _, h in list do
            local r = attempt(h)
            if r ~= nil then return r end
        end
        return nil
    end

    local function run_suite(s, indent)
        if count_selected(s) == 0 then return end
        if s.parent ~= nil and format == "pretty" then say(indent .. s.name) end
        local inner = s.parent ~= nil and (indent .. "  ") or indent
        -- a skipped group runs none of its hooks (they often need what is missing)
        local skipped = suite_skipped(s)
        local setup_err = nil
        if not skipped then setup_err = run_hooks(s.before_all) end
        for _, item in s.items do
            if item.items ~= nil then
                if setup_err == nil then run_suite(item, inner) end
            elseif selected(item, filter) then
                n = n + 1
                local status = "pass"
                local problem = nil
                local t0 = time.now()
                if item.mode == "todo" then
                    status = "todo"
                elseif item.mode == "skip" or suite_skipped(item.suite) then
                    status = "skip"
                elseif setup_err ~= nil then
                    status = setup_err.kind
                    problem = "before_all: " .. setup_err.message
                else
                    local chain = suite_chain(item.suite)
                    for _, cs in chain do
                        if problem == nil then
                            local r = run_hooks(cs.before_each)
                            if r ~= nil then
                                status = r.kind
                                problem = "before_each: " .. r.message
                            end
                        end
                    end
                    if problem == nil then
                        local r = attempt(item.fn)
                        if r ~= nil then
                            status = r.kind
                            problem = r.message
                        end
                    end
                    for i = len(chain) - 1, 0, -1 do
                        local r = run_hooks(chain[i].after_each)
                        if r ~= nil and problem == nil then
                            status = r.kind
                            problem = "after_each: " .. r.message
                        end
                    end
                end
                local ms = time.since(t0) / time.Millisecond
                local name = full_name(item)
                if status == "pass" then
                    res.passed = res.passed + 1
                elseif status == "skip" then
                    res.skipped = res.skipped + 1
                elseif status == "todo" then
                    res.todo = res.todo + 1
                else
                    res.failed = res.failed + 1
                    local f = {}
                    f.name = name
                    f.kind = status
                    f.message = problem
                    res.failures[] = f
                end
                if format == "pretty" then
                    local mark = status == "pass" and "✓" or (status == "skip" and "-" or (status == "todo" and "…" or "✗"))
                    local suffix = ""
                    if status == "skip" then suffix = " (skipped)" end
                    if status == "todo" then suffix = " (todo)" end
                    if status == "error" then suffix = " (error)" end
                    if timing and status == "pass" and ms >= 1 then suffix = string.format(" (%.0f ms)", ms) end
                    say(inner .. mark .. " " .. item.name .. suffix)
                elseif format == "tap" then
                    local line = (status == "pass" or status == "skip" or status == "todo") and "ok" or "not ok"
                    line = line .. " " .. tostring(n) .. " - " .. name
                    if status == "skip" then line = line .. " # SKIP" end
                    if status == "todo" then line = line .. " # TODO" end
                    say(line)
                    if problem ~= nil then
                        for _, l in string.split(problem, "\n") do say("  # " .. l) end
                    end
                end
            end
        end
        local teardown = nil
        if not skipped then teardown = run_hooks(s.after_all) end
        if teardown ~= nil then
            res.failed = res.failed + 1
            local f = {}
            f.name = (s.parent ~= nil and s.name or "(top)") .. " > after_all"
            f.kind = teardown.kind
            f.message = teardown.message
            res.failures[] = f
        end
    end

    run_suite(root, "")

    res.benches = []
    local bench = opts.bench or os.getenv("SEA_BENCH")
    if bench ~= nil and bench ~= "" then
        local budget = (opts.benchtime or tonumber(os.getenv("SEA_BENCHTIME") or "") or 1) * time.Second
        local width = 0
        for _, b in benches do
            if len(full_name(b)) > width then width = len(full_name(b)) end
        end
        if format == "pretty" and len(benches) > 0 then say("") end
        for _, b in benches do
            local name = full_name(b)
            if bench == "." or string.contains(name, bench) then
                local ns, problem, iters = run_bench(b, budget)
                if ns == nil then
                    res.failed = res.failed + 1
                    local f = {}
                    f.name = name
                    f.kind = problem.kind
                    f.message = problem.message
                    res.failures[] = f
                    if format == "pretty" then say("✗ " .. name .. " (benchmark)") end
                else
                    local r = {}
                    r.name = name
                    r.n = iters
                    r.ns_per_op = ns
                    res.benches[] = r
                    if format == "pretty" then
                        say(string.format("%-" .. tostring(width) .. "s  %10d  %14.1f ns/op", name, iters, ns))
                    elseif format == "tap" then
                        say(string.format("# bench %s %d %.1f ns/op", name, iters, ns))
                    end
                end
            end
        end
    end

    res.total = res.passed + res.failed + res.skipped + res.todo
    res.ok = res.failed == 0
    has_run = true
    -- for `sea test`: the counts of this file
    local counts_file = os.getenv("SEA_TEST_RESULT")
    if counts_file ~= nil then
        fs.write(counts_file, string.format("%d %d %d %d %d", res.passed, res.failed, res.skipped, res.todo, len(res.benches)))
    end
    if format == "pretty" then
        for i = 0, len(res.failures) - 1 do
            local f = res.failures[i]
            say("")
            say(tostring(i + 1) .. ") " .. f.name .. (f.kind == "error" and " (error)" or ""))
            for _, l in string.split(f.message, "\n") do say("   " .. l) end
        end
        say("")
        local parts = []
        parts[] = tostring(res.passed) .. " passed"
        if res.failed > 0 then parts[] = tostring(res.failed) .. " failed" end
        if res.skipped > 0 then parts[] = tostring(res.skipped) .. " skipped" end
        if res.todo > 0 then parts[] = tostring(res.todo) .. " todo" end
        local summary = string.join(parts, ", ")
        if timing then summary = summary .. string.format(" (%.2f s)", time.since(t_start) / time.Second) end
        say(summary)
    end
    return res
end

-- t.main([opts]): run, then exit with status 1 when something failed
function T.main(opts)
    local res = T.run(opts)
    os.exit(res.ok and 0 or 1)
end

-- t.has_run() → whether t.run (or t.main) ran since the tests were defined
function T.has_run() return has_run end

-- t.reset(): forget every test defined so far (for running several files)
function T.reset()
    root = new_suite("", nil)
    current = root
    benches = []
    has_only = false
    has_run = false
end

return T
