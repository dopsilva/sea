-- Regression (Bug 20): a local captured by a closure that was not created
-- (its branch did not run) must still be released when its scope ends, on
-- every path out: end of block, break/continue, return.

local function rss_kb()
    if not fs.exists("/proc/self/statm") then return 0 end   -- no procfs (macOS): the growth check is skipped
    return tonumber(string.split(os.readfile("/proc/self/statm"), " ")[1]) * 4
end

local holder = nil

local function make()
    local d = {}
    d.payload = string.rep("x", 200)
    return d
end

local function returns(flag)
    local data = make()
    if flag then
        holder = function() return data end
    end
    return 1
end

local function churn(n)
    for i = 1, n do
        local db = make()
        if i < 0 then
            holder = function() return db end
        end
        local again = make()
        if i < 0 then
            holder = function() return again end
        end
        if i % 3 == 0 then
            continue
        end
        local _ = returns(false)
    end
    local k = 0
    while true do
        k = k + 1
        local w = make()
        if k < 0 then holder = function() return w end end
        if k >= n then break end
    end
end

churn(2000)
local before = rss_kb()
churn(100000)
local grown = rss_kb() - before
-- ASAN keeps freed memory in quarantine, so RSS says nothing there
print(os.getenv("ASAN_OPTIONS") != nil or grown < 8000)

-- the closures that do exist still see their values
local keep = []
for i = 1, 3 do
    local t = {}
    t.v = i
    if i != 2 then keep[] = function() return t.v end end
end
print(keep[0](), keep[1]())
print(returns(true), holder().payload == string.rep("x", 200))
