print(len(string.split(string.trim(fs.read(dir .. "/proj/sea.lock")), "\n")))
fs.remove(dir .. "/proj/sea_modules", {recursive = true})
print(hide(run_in("proj", {"get"})))
fs.write(dir .. "/proj/sea.toml", string.replace(fs.read(dir .. "/proj/sea.toml"), "v1.0.0", "v2.0.0"))
