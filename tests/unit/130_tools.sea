-- Test: the built-in tools `sea fmt` and `sea doc` (run as ./bin/sea from the repo root)
local SEA = "./bin/sea"
local stream = require("sea/stream")

local dir = fs.realpath(fs.tempdir("seatools-"))   -- resolved: on macOS /var is a link to /private/var
local function run(args, stdin)
    local cmd = []
    cmd[] = SEA
    for i = 0, len(args) - 1 do cmd[] = args[i] end
    local opts = {}
    opts.cwd = dir
    if stdin ~= nil then opts.stdin = stdin end
    local r = process.run(cmd, opts)
    if is_error(r) then return r.message end
    return "[" .. tostring(r.code) .. "] " .. string.trim(r.stdout) .. (r.stderr ~= "" and (" | " .. string.trim(r.stderr)) or "")
end
-- the binary path relative to dir: absolute
SEA = fs.realpath(SEA)

print("-- sea fmt")
fs.write(dir .. "/a.sea", "local   x=1\nif x then print( x ) end\n")
fs.write(dir .. "/ok.sea", "local y = 2\n")
fs.mkdir(dir .. "/sub")
fs.write(dir .. "/sub/bad.sea", "local = 1\n")
print(run({"fmt", "-l", "."}))
print(run({"fmt", "--check", "a.sea", "ok.sea"}))
print(run({"fmt", "-p", "a.sea"}))
print(run({"fmt"}, "local t={a=1}\n"))
print(run({"fmt", "a.sea"}), fs.read(dir .. "/a.sea") == "local x = 1\nif x then print(x) end\n")
print(run({"fmt", "--check", "a.sea", "ok.sea"}))
print(run({"fmt", "--bogus"}))

print("-- sea doc")
fs.remove(dir .. "/sub/bad.sea")
fs.write(dir .. "/mylib.sea", [==[
-- mylib — a small library
--
-- Usage:
--   local m = require("mylib")

local M = {}
local Box = {}

-- m.add(a, b) → the sum
function M.add(a, b)
    return a + b
end

--[[ m.join(...) → the values joined with ", " ]]
function M.join(...)
    return ""
end

-- the size of a box
function Box.size(self)
    return 1
end

local function helper(x)
    return x
end

-- a constant
M.VERSION = "1.0"

return M
]==]
)
print(run({"doc", "mylib.sea"}))
print(run({"doc", "mylib.sea", "add"}))
print(run({"doc", "--all", "mylib.sea", "helper"}))
print(run({"doc", "-f", "markdown", "mylib.sea", "join"}))
print(run({"doc", "-f", "json", "mylib.sea", "size"}))
print(run({"doc", "mylib.sea", "nothing"}))
local html = run({"doc", "-f", "html", "-o", "out.html", "mylib.sea"})
print(html, string.contains(fs.read(dir .. "/out.html"), "<code>m.add(a, b) → the sum</code>"))
print(string.sub(run({"doc", "re"}), 1, 40))

-- sea doc -http: a server on a free port, a few pages, then stop it
local srv = process.spawn({SEA, "doc", "-http", "127.0.0.1:0", "."}, {cwd = dir})
local banner = srv:read_line(5000)
local port = tonumber(re.match(":(\\d+)/", banner).groups[1])
print(string.sub(banner, 1, 22), port > 0)
local function get(target)
    local fd = net.connect("127.0.0.1", port, 2000)
    net.write(fd, "GET " .. target .. " HTTP/1.1\r\nHost: x\r\n\r\n")
    local resp = stream.reader(fd, {timeout = 5000}):read_all()
    net.close(fd)
    return resp
end
local function status(resp) return string.sub(resp, 10, 12) end
local page = get("/")
print(status(page), string.contains(page, "href=\"/m/mylib.sea\""), string.contains(page, "a small library"))
page = get("/m/mylib.sea")
print(status(page), string.contains(page, "<code>m.add(a, b) → the sum</code>"), string.contains(page, "href=\"/src/mylib.sea#L"))
page = get("/src/mylib.sea")
print(status(page), string.contains(page, "id=\"L12\""), string.contains(page, "<span class=\"k\">function</span>"))
page = get("/search?q=sum")
print(status(page), string.contains(page, "mylib.add"))
print(status(get("/builtin/fs")), status(get("/src/../../etc/passwd")), status(get("/nope")))
srv:kill()
srv:wait(2000)

print("-- sea test")
local function untimed(s)
    s = re.gsub("[0-9.]+ ns/op", s, "N ns/op")
    s = re.gsub("  +[0-9]+  +N", s, " N N")
    return re.gsub("\\([0-9.]+ s\\)", s, "(T)")
end
