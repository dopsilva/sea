-- tests/run_tests.sea — Sea VM unit test runner
--
-- Usage:
--   bin/sea tests/run_tests.sea [name-substring]
--
-- Plain text, one line per test: it reads the same in a terminal, a CI log
-- and a pipe (no animation, no escape codes). Each test is a .sea file in
-- tests/unit/ run as ./bin/sea with stdout and stderr merged; it passes when
-- the exit code is 0 and the output equals its .expected file (a test with no
-- .expected only has to exit 0). A test that runs longer than TEST_TIMEOUT
-- seconds (default 60) is killed and counts as a failure, so one hung test
-- cannot stall the whole run. Exit code 1 if anything failed.

local SEA  = "./bin/sea"
local UNIT = "./tests/unit"

local timeout_s = tonumber(os.getenv("TEST_TIMEOUT") or "60")
local filter = os.args[1]

local function trim_trailing_newline(s)
    local n = len(s)
    while n > 0 and (string.sub(s, n, n) == "\n" or string.sub(s, n, n) == "\r") do
        n = n - 1
    end
    return string.sub(s, 1, n)
end

-- the first lines that differ, "-" expected and "+" actual (enough to see why)
local function first_diff(expected, actual)
    local e = string.split(expected, "\n")
    local a = string.split(actual, "\n")
    local n = len(e)
    if len(a) > n then n = len(a) end
    local out = []
    local i = 0
    while i < n and len(out) < 12 do
        local el = nil
        local al = nil
        if i < len(e) then el = e[i] end
        if i < len(a) then al = a[i] end
        if el ~= al then
            out[] = "      line " .. (i + 1)
            if el ~= nil then out[] = "      - " .. el end
            if al ~= nil then out[] = "      + " .. al end
        end
        i = i + 1
    end
    return string.join(out, "\n")
end

local all = os.glob(UNIT, ".sea")
local files = []
for _, f in all do
    if filter == nil or string.contains(f, filter) then files[] = f end
end
local total = len(files)
print(total .. " testes em " .. UNIT .. "/ (limite " .. timeout_s .. " s cada)")

local pass = 0
local failed = []
for _, sea_file in files do
    local name = string.sub(sea_file, len(UNIT) + 2)
    name = string.sub(name, 1, len(name) - 4)
    local exp_file = UNIT .. "/" .. name .. ".expected"

    local opts = {}
    opts.stderr = "stdout"
    opts.timeout = math.floor(timeout_s * 1000)
    local t0 = time.now()
    local r = process.run([SEA, sea_file], opts)
    local secs = (time.since(t0) // time.Millisecond) / 1000

    local ok = true
    local why = ""
    local detail = ""
    if is_error(r) then
        ok = false
        why = "não rodou: " .. r.message
    elseif r.timed_out then
        ok = false
        why = "travou (limite de " .. timeout_s .. " s)"
        detail = trim_trailing_newline(r.stdout)
    elseif r.code ~= 0 then
        ok = false
        why = "saiu com código " .. r.code
        detail = trim_trailing_newline(r.stdout)
    else
        local exp_raw = os.readfile(exp_file)
        if exp_raw ~= nil then
            local expected = trim_trailing_newline(exp_raw)
            local actual = trim_trailing_newline(r.stdout)
            if actual ~= expected then
                ok = false
                why = "saída diferente do .expected"
                detail = first_diff(expected, actual)
            end
        end
    end

    if ok then
        pass = pass + 1
        print("ok    " .. name .. "  (" .. secs .. " s)")
    else
        print("FAIL  " .. name .. "  (" .. secs .. " s): " .. why)
        if detail ~= "" then
            -- a crash or a hang: the tail of the output; a mismatch: the diff
            local lines = string.split(detail, "\n")
            local from = 0
            if r.code ~= nil and (r.timed_out or r.code ~= 0) and len(lines) > 15 then from = len(lines) - 15 end
            for i = from, len(lines) - 1 do print("      " .. lines[i]) end
        end
        failed[] = name
    end
end

print("")
if len(failed) == 0 then
    print("Resultados: " .. pass .. "/" .. total .. " passaram")
else
    print("Resultados: " .. pass .. "/" .. total .. " passaram (" .. len(failed) .. " falha(s): " .. string.join(failed, ", ") .. ")")
    os.exit(1)
end
