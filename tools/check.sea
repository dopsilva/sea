-- sea check — find likely mistakes in Sea code without running it
--
--   sea check [flags] [path ...]
--
-- Paths are files or directories (searched for *.sea, skipping hidden
-- directories); the default is the current directory. Prints one line per
-- problem, file:line:col: message [code], and exits with status 1 when it
-- found any. The checks are listed in `sea check -h`; the rules come from the
-- built-in module sea/check.
--
--   -disable CODES   skip these checks (comma separated)
--   -only CODES      run only these checks
--   -g NAMES         names of globals defined elsewhere (comma separated)
--   -all             also report unused parameters and loop variables
--   -f text|json     output format (default text)
--   -w               exit with status 0 when there are only warnings

local check = require("sea/check")

local function code_set(s)
    local set = {}
    for _, c in string.split(s or "", ",") do
        c = string.trim(c)
        if c ~= "" then
            local okc = false
            for _, k in check.CODES do
                if k == c then okc = true end
            end
            if not okc then
                io.write_err("sea check: unknown check " .. c .. "\n")
                os.exit(2)
            end
            set[c] = true
        end
    end
    return set
end

local flags = require("sea/flags")

local cli = flags.new("sea check", {
    long = "-",
    usage = "[-disable CODES] [-only CODES] [-g NAMES] [-all] [-f text|json] [-w] [path ...]",
    about = string.join({
        "Checks (errors fail at run time, warnings are probable mistakes):",
        "  syntax       error    the file does not parse or compile",
        "  undefined    error    a variable that is not local, built in or set as a global anywhere",
        "  require      error    require() of a module that cannot be found",
        "  args         error    more arguments than a local function takes",
        "  format       error    string.format / printf arguments that do not match the format",
        "  unused       warning  a local variable or function that is never read",
        "  redeclared   warning  a local declared twice in the same block",
        "  shadow       warning  a local that hides a local of an enclosing block",
        "  unreachable  warning  code after return, break, continue or panic",
        "  dupkey       warning  a key written twice in a table literal",
        "  selfassign   warning  x = x",
        "  longstring   warning  [[a, b], [c, d]]: `[[` opens a long string, not a nested array",
        "",
        "A line ending with `-- check:ignore [codes]` is not checked.",
    }, "\n"),
})
local disable_flag = cli:string("disable", "", "skip these checks (comma separated)", {arg = "codes"})
local only_flag = cli:string("only", "", "run only these checks", {arg = "codes"})
local globals_flag = cli:list("g", "globals defined elsewhere (comma separated; may repeat)", {arg = "names"})
local all_flag = cli:bool("all", false, "also report unused parameters and loop variables")
local format_flag = cli:string("f", "text", "output format", {arg = "format", choices = {"text", "json"}})
local warn_flag = cli:bool("w", false, "exit with status 0 when there are only warnings")
local paths = cli:parse()

local disable = code_set(disable_flag.value)
local only = only_flag.set and code_set(only_flag.value) or nil
local extra = {}
for _, names in globals_flag.value do
    for _, g in string.split(names, ",") do
        if string.trim(g) ~= "" then extra[string.trim(g)] = true end
    end
end
local all = all_flag.value
local format = format_flag.value
local warn_ok = warn_flag.value
if len(paths) == 0 then paths[] = "." end
if only ~= nil then
    for _, c in check.CODES do
        if not only[c] then disable[c] = true end
    end
end

local files = []
for _, p in paths do
    if fs.isdir(p) then
        for _, f in fs.walk(p, {files = true}) do
            local hidden = false
            for _, part in path.parts(path.relative(p, f)) do
                if string.starts_with(part, ".") and part ~= "." and part ~= ".." then hidden = true end
            end
            if not hidden and path.ext(f) == ".sea" then files[] = path.normalize(f) end
        end
    elseif fs.exists(p) then
        files[] = p
    else
        io.write_err("sea check: " .. p .. ": no such file or directory\n")
        os.exit(2)
    end
end

-- Globals set in one file count as defined in the others
local sources = {}
local globals = {}
for _, f in files do
    local src = fs.read(f)
    sources[f] = src
    if not is_error(src) then
        for g, _ in check.defined_globals(src) do globals[g] = true end
    end
end
for g, _ in extra do globals[g] = true end

local opts = {}
opts.globals = globals
opts.disable = disable
opts.all_unused = all

local function json_str(s)
    s = string.replace(s, "\\", "\\\\")
    s = string.replace(s, "\"", "\\\"")
    s = string.replace(s, "\n", "\\n")
    s = string.replace(s, "\t", "\\t")
    return "\"" .. s .. "\""
end

local errors = 0
local warnings = 0
local json = []
for _, f in files do
    local diags = check.file(f, opts)
    for _, d in diags do
        if d.severity == "error" then errors = errors + 1 else warnings = warnings + 1 end
        if format == "json" then
            json[] = string.format("{\"file\": %s, \"line\": %d, \"col\": %d, \"code\": %s, \"severity\": %s, \"message\": %s}",
                json_str(d.file), d.line, d.col, json_str(d.code), json_str(d.severity), json_str(d.message))
        else
            print(string.format("%s:%d:%d: %s [%s]", d.file, d.line, d.col, d.message, d.code))
        end
    end
end
if format == "json" then
    if len(json) == 0 then print("[]") else print("[\n  " .. string.join(json, ",\n  ") .. "\n]") end
end
if errors > 0 or (warnings > 0 and not warn_ok) then os.exit(1) end
