-- sea doc — documentation from Sea source comments (built into the sea binary)
--
--   sea doc [flags] [path ...] [name]
--
-- Reads .sea files (directories are searched, skipping hidden ones; default
-- the current directory) and prints the documentation of each module: the
-- comment at the top of the file, then each function with the comment
-- right above it. A name shows only the matching functions; the name of a
-- built-in module (fs, string, re, ...) lists its functions.
--
--   -f, --format F   text (default), markdown, html or json
--   -o FILE          write to FILE instead of stdout
--   --all            include local (private) functions
--   -http [HOST]:PORT serve the documentation as web pages (an index of the
--                    modules, a page per module, the source with line numbers,
--                    search, the built-in modules); HOST defaults to 127.0.0.1.
--                    Files are read again on each request: edit and reload.
--   -open            with -http, open the index in the browser (xdg-open)

local parser = require("sea/parser")
local stream = require("sea/stream")

local BUILTINS = {
    "math", "string", "utf8", "re", "encoding", "hash", "io", "os", "fs", "path",
    "process", "sync", "time", "net", "gc", "sort", "bigint", "list", "json", "csv", "sea/parser",
}

local flags = require("sea/flags")

local cli = flags.new("sea doc", {
    usage = "[-f text|markdown|html|json] [-o file] [--all] [path ...] [name]\n" ..
        "       sea doc -http [host]:port [-open] [--all] [path ...]",
    about = "Prints the documentation in the comments of Sea source files: the comment\n" ..
        "at the top of a file, and the comment right above each function; -http serves\n" ..
            "them as web pages (e.g. sea doc -http :6060 -open).",
})
local format_flag = cli:string("f", "text", "output format", {alias = "format", arg = "format", choices = {"text", "markdown", "md", "html", "json"}})
local out_flag = cli:string("o", "", "write to a file instead of stdout", {arg = "file"})
local all_flag = cli:bool("all", false, "include local (private) functions")
local http_flag = cli:string("http", "", "serve the documentation as web pages", {arg = "[host]:port"})
local open_flag = cli:bool("open", false, "with -http, open the index in the browser")
local args = cli:parse()

local format = format_flag.value
local outfile = out_flag.set and out_flag.value or nil
local show_all = all_flag.value
local http_addr = http_flag.set and http_flag.value or nil
local open_browser = open_flag.value
if format == "md" then format = "markdown" end

-- ---- output buffer ------------------------------------------------------------------

local out = []
local function emit(s)
    out[] = s
end

-- ---- comments → text --------------------------------------------------------------------

-- The text of one comment: without "--" (or the long brackets), dedented.
local function comment_text(raw)
    local m = re.match("^--\\[(=*)\\[", raw)
    if m ~= nil then
        local level = len(m.groups[1])
        local body = string.sub(raw, len(m.text) + 1, len(raw) - 2 - level)
        if string.starts_with(body, "\n") then body = string.sub(body, 2) end
        local lines = string.split(body, "\n")
        -- the smallest indentation of the non-blank lines
        local strip = nil
        for _, l in lines do
            if string.trim(l) ~= "" then
                local ind = len(re.match("^[ \\t]*", l).text)
                if strip == nil or ind < strip then strip = ind end
            end
        end
        local res = []
        for _, l in lines do res[] = string.sub(l, (strip or 0) + 1) end
        return string.trim(string.join(res, "\n"))
    end
    local t = re.gsub("^-+", raw, "")
    if string.starts_with(t, " ") then t = string.sub(t, 2) end
    return re.gsub("\\s+$", t, "")
end

local function count_lines(s)
    return len(re.findall("\n", s))
end

-- ---- reading a file ---------------------------------------------------------------------

local function func_params(f, drop_self)
    local names = []
    for idx, p in f.params do
        if not (drop_self and idx == 0 and p.name == "self") then
            names[] = p.is_vararg and "..." or p.name
        end
    end
    return string.join(names, ", ")
end

-- A dotted name from a field/ident chain (a.b.c), or nil.
local function chain(node)
    if node.type == "ident" then return node.name end
    if node.type == "field" then
        local base = chain(node.object)
        if base == nil then return nil end
        return base .. "." .. node.field
    end
    return nil
end

local function new_entry(name, kind, params, doc, line)
    local e = {}
    e.name = name
    e.kind = kind
    e.params = params
    e.doc = doc
    e.line = line
    return e
end

local function read_module(file)
    local src = fs.read(file)
    if is_error(src) then return src end
    local ast = parser.parse(src, {name = file, comments = true})
    if is_error(ast) then return ast end

    -- comments by the line they end on (not those after code)
    local by_end = [=]
    for _, c in ast.comments do
        if not c.inline then by_end[c.line + count_lines(c.text)] = c end
    end
    local function doc_above(line)
        local parts = []
        local l = line - 1
        while by_end[l] ~= nil do
            local c = by_end[l]
            parts[] = comment_text(c.text)
            l = c.line - 1
        end
        local res = []
        for k = len(parts) - 1, 0, -1 do res[] = parts[k] end
        return string.trim(string.join(res, "\n"))
    end

    local mod = {}
    mod.file = file
    mod.name = path.stem(file)
    mod.doc = ""
    mod.entries = []
    local stmts = ast.stmts
    local table_name = nil
    for _, s in stmts do
        if s.type == "return" and len(s.values) == 1 and s.values[0].type == "ident" then
            table_name = s.values[0].name
        end
    end

    -- the module comment: the comment block at the top, unless it sits right
    -- on the first statement; a license header block (SPDX-License-Identifier)
    -- before it is skipped
    local first_line = len(stmts) > 0 and stmts[0].line or 1000000000
    local blocks = []
    local block = nil
    local last_end = 0
    for _, c in ast.comments do
        if c.inline or c.line >= first_line then break end
        if not string.starts_with(c.text, "#!") then
            if block == nil or c.line > last_end + 1 then
                block = []
                blocks[] = block
            end
            block[] = c
            last_end = c.line + count_lines(c.text)
        end
    end
    local function block_end(b)
        local c = b[len(b) - 1]
        return c.line + count_lines(c.text)
    end
    local function is_license(b)
        for _, c in b do
            if string.contains(c.text, "SPDX-License-Identifier") then return true end
        end
        return false
    end
    local top = nil
    if len(blocks) > 0 and not is_license(blocks[0]) then
        top = blocks[0]
    elseif len(blocks) > 1 and block_end(blocks[0]) + 1 < blocks[1][0].line then
        top = blocks[1]
    end
    if top ~= nil and block_end(top) < first_line - 1 then
        local parts = []
        for _, c in top do parts[] = comment_text(c.text) end
        mod.doc = string.trim(string.join(parts, "\n"))
    end

    local function display(owner, field)
        if owner == table_name then return mod.name .. "." .. field end
        return owner .. "." .. field
    end

    for _, s in stmts do
        if s.type == "assign" and len(s.targets) == 1 and len(s.values) == 1 then
            local t = s.targets[0]
            local v = s.values[0]
            local name = chain(t)
            if name ~= nil then
                local doc = doc_above(s.line)
                if v.type == "func" then
                    local is_method = v.is_method or (len(v.params) > 0 and v.params[0].name == "self")
                    local shown
                    if t.type == "field" then
                        local owner = chain(t.object)
                        shown = display(owner, t.field)
                        if is_method then
                            shown = (owner == table_name and mod.name or owner) .. ":" .. t.field
                        end
                    else
                        shown = name
                    end
                    local kind = t.type == "ident" and "global" or (is_method and "method" or "function")
                    mod.entries[] = new_entry(shown, kind, func_params(v, is_method), doc, s.line)
                elseif t.type == "field" and doc ~= "" then
                    mod.entries[] = new_entry(display(chain(t.object), t.field), "field", nil, doc, s.line)
                end
            end
        elseif s.type == "local" and show_all and len(s.values) >= 1 and s.values[0].type == "func" then
            mod.entries[] = new_entry(s.names[0], "local", func_params(s.values[0], false), doc_above(s.line), s.line)
        end
    end
    return mod
end

-- ---- built-in modules -------------------------------------------------------------------

-- the API tables of docs/reference.md: "module.function" → {signature, description}
local ref_index = nil
local function ref_lookup(name)
    if ref_index == nil then
        ref_index = {}
        local rows = require("sea/ref")
        for _, row in rows do ref_index[row[0]] = row end
    end
    return ref_index[name]
end

-- "split(s, sep [, n]) → array" → "s, sep [, n]" and "array"
local function split_signature(sig)
    local open = string.find(sig, "(", 1, true)
    if open == nil then return nil, sig end
    local depth = 0
    for i = open, len(sig) do
        local c = string.sub(sig, i, i)
        if c == "(" then depth = depth + 1 end
        if c == ")" then
            depth = depth - 1
            if depth == 0 then
                local tail = string.trim(string.sub(sig, i + 1))
                if string.starts_with(tail, "→") then tail = string.trim(string.sub(tail, len("→") + 1)) end
                return string.sub(sig, open + 1, i - 1), tail
            end
        end
    end
    return nil, sig
end

local function builtin_module(name)
    local m = require(name)
    local mod = {}
    mod.file = "built in"
    mod.name = name
    mod.doc = "Built-in module " .. name .. ". The full reference is docs/reference.md in the Sea repository."
    mod.entries = []
    local keys = []
    for k, _ in m do keys[] = k end
    sort.sort(keys)
    for _, k in keys do
        local v = m[k]
        local kind = type(v) == "function" and "function" or "field"
        local shown = string.replace(name, "sea/", "") .. "." .. k
        local params = kind == "function" and "..." or nil
        local doc = ""
        local row = ref_lookup(shown)
        if row ~= nil then
            local ps, ret = split_signature(row[1])
            if ps ~= nil then params = ps end
            doc = row[2]
            if ret ~= "" and ps ~= nil then doc = "Returns " .. ret .. ". " .. doc end
        end
        mod.entries[] = new_entry(shown, kind, params, doc, 0)
    end
    return mod
end

-- ---- doc text → blocks (paragraphs and code) ------------------------------------------

-- Lines indented by two or more spaces form code blocks; the rest are
-- paragraphs (split at blank lines).
local function blocks(doc)
    local res = []
    local cur = nil
    for _, line in string.split(doc, "\n") do
        local kind = nil
        if string.trim(line) == "" then
            kind = "blank"
        elseif string.starts_with(line, "  ") or string.starts_with(line, "\t") then
            kind = "code"
        else
            kind = "p"
        end
        if kind == "blank" then
            if cur ~= nil and cur.kind == "code" then cur.lines[] = "" else cur = nil end
        else
            if cur == nil or cur.kind ~= kind then
                cur = {}
                cur.kind = kind
                cur.lines = []
                res[] = cur
            end
            cur.lines[] = line
        end
    end
    for _, b in res do
        -- no blank lines at the end of a code block
        while b.kind == "code" and len(b.lines) > 0 and b.lines[len(b.lines) - 1] == "" do
            local keep = []
            for k = 0, len(b.lines) - 2 do keep[] = b.lines[k] end
            b.lines = keep
        end
        if b.kind == "code" then
            local strip = nil
            for _, l in b.lines do
                if l ~= "" then
                    local ind = len(re.match("^[ \\t]*", l).text)
                    if strip == nil or ind < strip then strip = ind end
                end
            end
            local d = []
            for _, l in b.lines do d[] = string.sub(l, (strip or 0) + 1) end
            b.lines = d
        end
    end
    return res
end

local function signature(e)
    if e.params == nil then return e.name end
    return e.name .. "(" .. e.params .. ")"
end

local function sections(mod)
    local fns = []
    local groups = [=]
    local order = []
    for _, e in mod.entries do
        local owner = re.match("^([^.:]+)[.:]", e.name)
        local gname = owner ~= nil and owner.groups[1] or nil
        if e.kind == "global" or e.kind == "local" or gname == nil or gname == mod.name then
            fns[] = e
        else
            if groups[gname] == nil then
                groups[gname] = []
                order[] = gname
            end
            groups[gname][] = e
        end
    end
    return fns, groups, order
end

-- ---- text -------------------------------------------------------------------------------

local function indent_text(s, pad)
    local res = []
    for _, l in string.split(s, "\n") do res[] = l == "" and "" or pad .. l end
    return string.join(res, "\n")
end

local function text_entries(list)
    for _, e in list do
        emit("  " .. signature(e) .. (e.kind == "local" and "   (local)" or ""))
        if e.doc ~= "" then emit(indent_text(e.doc, "      ")) end
        emit("")
    end
end

local function render_text(mods)
    for idx, mod in mods do
        if idx > 0 then emit("") end
        emit(string.upper(mod.name) .. "  (" .. mod.file .. ")")
        emit("")
        if mod.doc ~= "" then
            emit(indent_text(mod.doc, "    "))
            emit("")
        end
        local fns, groups, order = sections(mod)
        if len(fns) > 0 then
            emit("FUNCTIONS")
            emit("")
            text_entries(fns)
        end
        for _, g in order do
            emit(string.upper(g))
            emit("")
            text_entries(groups[g])
        end
    end
end

-- ---- markdown -----------------------------------------------------------------------------

local function md_doc(doc)
    for _, b in blocks(doc) do
        if b.kind == "code" then
            emit("```sea")
            for _, l in b.lines do emit(l) end
            emit("```")
        else
            emit(string.join(b.lines, "\n"))
        end
        emit("")
    end
end

local function md_entries(list)
    for _, e in list do
        emit("### `" .. signature(e) .. "`" .. (e.kind == "local" and " (local)" or ""))
        emit("")
        if e.doc ~= "" then md_doc(e.doc) end
    end
end

local function render_markdown(mods)
    for _, mod in mods do
        emit("# " .. mod.name)
        emit("")
        emit("`" .. mod.file .. "`")
        emit("")
        if mod.doc ~= "" then md_doc(mod.doc) end
        local fns, groups, order = sections(mod)
        if len(fns) > 0 then
            emit("## Functions")
            emit("")
            md_entries(fns)
        end
        for _, g in order do
            emit("## " .. g)
            emit("")
            md_entries(groups[g])
        end
    end
end

-- ---- html -----------------------------------------------------------------------------------

local function esc(s)
    s = string.replace(s, "&", "&amp;")
    s = string.replace(s, "<", "&lt;")
    s = string.replace(s, ">", "&gt;")
    return string.replace(s, "\"", "&quot;")
end

local function anchor(s)
    return re.gsub("[^A-Za-z0-9_.-]", s, "-")
end

-- A path as it goes in a URL: bytes other than letters, digits and _ . / - as %XX.
local function url_path(s)
    local res = []
    for k = 1, len(s) do
        local c = string.sub(s, k, k)
        if re.test("^[A-Za-z0-9_./-]$", c) then res[] = c else res[] = string.format("%%%02X", string.byte(c)) end
    end
    return string.join(res, "")
end

-- Set by the server: the href of a module page and of a source line (nil in a static page).
local module_href = nil
local source_href = nil

local CSS = [==[
:root{--bg:#fff;--fg:#1d2330;--muted:#5d6675;--line:#e3e6eb;--code:#f4f6f8;--link:#1f5fbf;--kw:#8839ef;--str:#2a7d3f;--num:#b35900;--com:#7a8290}
@media (prefers-color-scheme: dark){:root{--bg:#14171c;--fg:#e4e7ec;--muted:#9aa3af;--line:#2a2f37;--code:#1d2128;--link:#7fb0ff;--kw:#c79bff;--str:#8fd19e;--num:#f0a35e;--com:#8a929e}}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.55 system-ui,sans-serif;display:flex}
a{color:var(--link)}
nav{width:250px;flex:none;border-right:1px solid var(--line);padding:16px;height:100vh;position:sticky;top:0;overflow:auto;box-sizing:border-box}
nav a{display:block;color:var(--fg);text-decoration:none;padding:2px 0;font-size:14px;overflow-wrap:anywhere}nav a.sub{padding-left:12px;color:var(--muted)}
nav .home{font-weight:600;margin-bottom:8px}
nav form{margin:0 0 12px}nav input{width:100%;box-sizing:border-box;padding:5px 8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg);font:inherit;font-size:14px}
main{flex:1;min-width:0;max-width:900px;padding:24px 32px}h1{margin-top:0;overflow-wrap:anywhere}h2{border-bottom:1px solid var(--line);padding-bottom:4px;margin-top:32px}
h3{font-size:16px;margin:22px 0 6px}h3 a{color:var(--link);text-decoration:none}code,pre{font-family:ui-monospace,monospace;font-size:13.5px}
pre{background:var(--code);padding:10px 12px;border-radius:6px;overflow:auto}p{white-space:pre-line;margin:6px 0}.file{color:var(--muted)}
.tag{font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:4px;padding:0 4px}
a.src{font-size:12px;font-weight:normal;margin-left:8px;color:var(--muted)}
table.index{border-collapse:collapse;width:100%}table.index td{padding:6px 12px 6px 0;border-bottom:1px solid var(--line);vertical-align:top}
table.index td:first-child{white-space:nowrap}
table.index th{text-align:left;font-weight:600;padding:18px 0 4px;border-bottom:1px solid var(--line);color:var(--muted);font-size:13px}
nav .dir{color:var(--muted);font-size:12px;margin-top:10px;overflow-wrap:anywhere}td.summary{color:var(--muted)}
.source{display:flex;background:var(--code);border-radius:6px;overflow:auto}.source pre{margin:0;background:none;border-radius:0;overflow:visible}
.source .ln{text-align:right;color:var(--muted);user-select:none;border-right:1px solid var(--line);padding-right:10px}
.source .ln a{color:inherit;text-decoration:none}.source .ln a:target{color:var(--link);font-weight:700}
.k{color:var(--kw)}.s{color:var(--str)}.n{color:var(--num)}.c{color:var(--com);font-style:italic}
@media (max-width:700px){body{display:block}nav{width:auto;height:auto;position:static;border-right:0;border-bottom:1px solid var(--line)}main{padding:16px}}
]==]

local function html_head(title)
    emit("<!doctype html>")
    emit("<html lang=\"en\"><head><meta charset=\"utf-8\">")
    emit("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
    emit("<title>" .. esc(title) .. "</title>")
    emit("<style>" .. CSS .. "</style></head><body>")
end

local function html_doc(doc)
    for _, b in blocks(doc) do
        if b.kind == "code" then
            emit("<pre><code>" .. esc(string.join(b.lines, "\n")) .. "</code></pre>")
        else
            emit("<p>" .. esc(string.join(b.lines, "\n")) .. "</p>")
        end
    end
end

-- The heading of an entry and the doc below it. When the doc starts with the
-- signature written by hand ("store:login(email, password) → token | error"),
-- that line is the heading: it says more than the parameter names.
local function entry_heading(e)
    local lines = string.split(e.doc, "\n")
    local first = lines[0] or ""
    local short = re.gsub("^.*[.:]", e.name, "")
    if e.params ~= nil and re.test("^([A-Za-z_][A-Za-z0-9_]*[.:])*" .. re.escape(short) .. "\\(", first) then
        local rest = []
        for k = 1, len(lines) - 1 do rest[] = lines[k] end
        return first, string.trim(string.join(rest, "\n"))
    end
    return signature(e), e.doc
end

local function html_entries(mod, list)
    for _, e in list do
        local id = anchor(mod.name .. "--" .. e.name)
        local src = ""
        if source_href ~= nil and e.line > 0 then
            src = "<a class=\"src\" href=\"" .. source_href(mod, e.line) .. "\">source</a>"
        end
        local head, doc = entry_heading(e)
        emit("<section class=\"entry\" id=\"" .. id .. "\">")
        emit("<h3><a href=\"#" .. id .. "\"><code>" .. esc(head) .. "</code></a>" ..
            (e.kind == "local" and " <span class=\"tag\">local</span>" or "") .. src .. "</h3>")
        if doc ~= "" then html_doc(doc) end
        emit("</section>")
    end
end

local function html_nav_entries(mod)
    emit("<a href=\"#" .. anchor(mod.name) .. "\"><strong>" .. esc(mod.name) .. "</strong></a>")
    for _, e in mod.entries do
        emit("<a class=\"sub\" href=\"#" .. anchor(mod.name .. "--" .. e.name) .. "\">" .. esc(e.name) .. "</a>")
    end
end

local function html_module(mod)
    emit("<h1 id=\"" .. anchor(mod.name) .. "\">" .. esc(mod.name) .. "</h1>")
    local file = esc(mod.file)
    if source_href ~= nil and mod.file ~= "built in" then
        file = "<a href=\"" .. source_href(mod, nil) .. "\">" .. file .. "</a>"
    end
    emit("<div class=\"file\">" .. file .. "</div>")
    if mod.doc ~= "" then html_doc(mod.doc) end
    local fns, groups, order = sections(mod)
    if len(fns) > 0 then
        emit("<h2>Functions</h2>")
        html_entries(mod, fns)
    end
    for _, g in order do
        emit("<h2>" .. esc(g) .. "</h2>")
        html_entries(mod, groups[g])
    end
end

-- One page with every module (sea doc -f html).
local function render_html(mods)
    html_head(len(mods) == 1 and mods[0].name or "Sea documentation")
    emit("<nav>")
    for _, mod in mods do html_nav_entries(mod) end
    emit("</nav><main>")
    for _, mod in mods do html_module(mod) end
    emit("</main></body></html>")
end

-- ---- html: the pages of the server (sea doc -http) -------------------------------------------

local function summary(mod)
    local first = string.split(mod.doc, "\n")[0] or ""
    -- "name — what it is": keep what it is
    local m = re.match("^\\S+\\s+(—|--|-)\\s+(.*)$", first)
    if m ~= nil then return m.groups[2] end
    return first
end

local function server_nav(extra)
    emit("<nav><a class=\"home\" href=\"/\">Sea documentation</a>")
    emit("<form action=\"/search\"><input name=\"q\" placeholder=\"Search\" aria-label=\"Search\"></form>")
    if extra ~= nil then extra() end
    emit("</nav><main>")
end

-- The modules by directory: the directories in order, and the modules of each.
local function by_dir(mods)
    local order = []
    local groups = [=]
    for _, mod in mods do
        local d = path.dirname(mod.file)
        if groups[d] == nil then
            groups[d] = []
            order[] = d
        end
        groups[d][] = mod
    end
    return order, groups
end

local function page_index(mods, title)
    local order, groups = by_dir(mods)
    html_head(title)
    server_nav(function()
        for _, d in order do
            emit("<div class=\"dir\">" .. esc(d) .. "</div>")
            for _, mod in groups[d] do
                emit("<a class=\"sub\" href=\"" .. module_href(mod) .. "\" title=\"" .. esc(mod.file) .. "\">" ..
                    esc(mod.name) .. "</a>")
            end
        end
    end)
    emit("<h1>" .. esc(title) .. "</h1>")
    if len(mods) > 0 then
        emit("<table class=\"index\">")
        for _, d in order do
            emit("<tr><th colspan=\"2\">" .. esc(d) .. "</th></tr>")
            for _, mod in groups[d] do
                emit("<tr><td><a href=\"" .. module_href(mod) .. "\" title=\"" .. esc(mod.file) .. "\">" .. esc(mod.name) ..
                    "</a></td><td class=\"summary\">" .. esc(summary(mod)) .. "</td></tr>")
            end
        end
        emit("</table>")
    else
        emit("<p>No documented Sea code found.</p>")
    end
    emit("<h2>Built-in modules</h2><table class=\"index\">")
    for _, b in BUILTINS do
        emit("<tr><td><a href=\"/builtin/" .. url_path(b) .. "\">" .. esc(b) .. "</a></td><td class=\"summary\">" ..
            "require(\"" .. esc(b) .. "\")" .. "</td></tr>")
    end
    emit("</table></main></body></html>")
end

local function page_module(mod)
    html_head(mod.name)
    server_nav(function() html_nav_entries(mod) end)
    html_module(mod)
    emit("</main></body></html>")
end

-- The source of a file with line numbers and highlighting (tokens from sea/parser).
local function page_source(mod, src)
    html_head(mod.file)
    server_nav(function()
        emit("<a href=\"" .. module_href(mod) .. "\"><strong>" .. esc(mod.name) .. "</strong></a>")
    end)
    emit("<h1>" .. esc(mod.file) .. "</h1>")
    local nlines = len(string.split(src, "\n"))
    if string.ends_with(src, "\n") then nlines = nlines - 1 end
    local nums = []
    for n = 1, nlines do nums[] = "<a id=\"L" .. n .. "\" href=\"#L" .. n .. "\">" .. n .. "</a>" end
    -- byte offset of each line start, to place the tokens
    local starts_list = []
    starts_list[] = 0
    local pos = string.find(src, "\n")
    while pos ~= nil do
        starts_list[] = pos
        pos = string.find(src, "\n", pos + 1)
    end
    local code = []
    local toks = parser.tokenize(src, {comments = true})
    if is_error(toks) then
        code[] = esc(src)
    else
        local at = 0 -- bytes of src already written
        for _, tk in toks do
            local off = starts_list[tk.line - 1] + tk.col - 1
            if off >= at then
                code[] = esc(string.sub(src, at + 1, off))
                local cls = nil
                if tk.kind == "keyword" then
                    cls = "k"
                elseif tk.kind == "string" then
                    cls = "s"
                elseif tk.kind == "number" then
                    cls = "n"
                elseif tk.kind == "comment" then
                    cls = "c"
                end
                local text = string.sub(src, off + 1, off + len(tk.text))
                code[] = cls == nil and esc(text) or "<span class=\"" .. cls .. "\">" .. esc(text) .. "</span>"
                at = off + len(tk.text)
            end
        end
        code[] = esc(string.sub(src, at + 1))
    end
    emit("<div class=\"source\"><pre class=\"ln\">" .. string.join(nums, "\n") .. "</pre><pre><code>" ..
        string.join(code, "") .. "</code></pre></div>")
    emit("</main></body></html>")
end

local function page_search(mods, q)
    html_head("Search: " .. q)
    server_nav(nil)
    emit("<h1>Search: " .. esc(q) .. "</h1>")
    local needle = string.lower(q)
    local hits = 0
    emit("<table class=\"index\">")
    for _, mod in mods do
        for _, e in mod.entries do
            local in_name = string.contains(string.lower(e.name), needle)
            if in_name or string.contains(string.lower(e.doc), needle) then
                hits = hits + 1
                local first = string.split(e.doc, "\n")[0] or ""
                emit("<tr><td><a href=\"" .. module_href(mod) .. "#" .. anchor(mod.name .. "--" .. e.name) .. "\"><code>" ..
                    esc(signature(e)) .. "</code></a></td><td class=\"summary\">" .. esc(mod.file) .. " — " ..
                        esc(first) .. "</td></tr>")
            end
        end
    end
    emit("</table>")
    if hits == 0 then emit("<p>Nothing found.</p>") end
    emit("</main></body></html>")
end

local function page_not_found(what)
    html_head("Not found")
    server_nav(nil)
    emit("<h1>Not found</h1><p>" .. esc(what) .. "</p></main></body></html>")
end

-- ---- json -------------------------------------------------------------------------------------

local function jstr(s)
    if s == nil then return "null" end
    s = string.replace(s, "\\", "\\\\")
    s = string.replace(s, "\"", "\\\"")
    s = string.replace(s, "\n", "\\n")
    s = string.replace(s, "\t", "\\t")
    s = string.replace(s, "\r", "\\r")
    return "\"" .. s .. "\""
end

local function render_json(mods)
    local ms = []
    for _, mod in mods do
        local es = []
        for _, e in mod.entries do
            es[] = "{\"name\": " .. jstr(e.name) .. ", \"kind\": " .. jstr(e.kind) .. ", \"params\": " ..
                jstr(e.params) .. ", \"line\": " .. tostring(e.line) .. ", \"doc\": " .. jstr(e.doc) .. "}"
        end
        ms[] = "{\"name\": " .. jstr(mod.name) .. ", \"file\": " .. jstr(mod.file) .. ", \"doc\": " .. jstr(mod.doc) ..
            ", \"entries\": [" .. string.join(es, ", ") .. "]}"
    end
    emit("[" .. string.join(ms, ",\n ") .. "]")
end

-- ---- main -----------------------------------------------------------------------------------

local paths = []
local filter = nil
local builtin = nil
for _, a in args do
    if fs.exists(a) then
        paths[] = a
    else
        local is_builtin = false
        for _, b in BUILTINS do
            if b == a then is_builtin = true end
        end
        local dot = string.find(a, ".", 1, true)
        local prefix = dot ~= nil and string.sub(a, 1, dot - 1) or nil
        local prefix_builtin = false
        for _, b in BUILTINS do
            if b == prefix then prefix_builtin = true end
        end
        if is_builtin then
            builtin = a
        elseif prefix_builtin and builtin == nil and filter == nil then
            builtin = prefix                 -- sea doc string.split
            filter = a
        elseif filter == nil then
            filter = a
        else
            print("sea doc: " .. a .. ": no such file, directory or built-in module")
            os.exit(2)
        end
    end
end
if len(paths) == 0 then paths[] = "." end

-- The documented modules under the paths, read now (the server calls it on each request,
-- so edits show up on reload).
local function load_modules()
    local files = []
    for _, p in paths do
        if fs.isdir(p) then
            for _, f in fs.walk(p, {files = true}) do
                local hidden = false
                for _, part in path.parts(path.relative(p, f)) do
                    if string.starts_with(part, ".") and part ~= "." and part ~= ".." then hidden = true end
                end
                if not hidden and path.ext(f) == ".sea" then files[] = path.normalize(f) end
            end
        else
            files[] = path.normalize(p)
        end
    end
    sort.sort(files)
    local mods = []
    for _, f in files do
        local m = read_module(f)
        if is_error(m) then
            io.write_err("sea doc: " .. m.message .. "\n")
        elseif len(m.entries) > 0 or m.doc ~= "" then
            mods[] = m
        end
    end
    return mods
end

-- ---- the server (sea doc -http) ----------------------------------------------------------------

local function url_decode(s)
    s = string.replace(s, "+", " ")
    return re.gsub("%([0-9A-Fa-f][0-9A-Fa-f])", s, function(m)
        return string.char(tonumber("0x" .. m.groups[1]))
    end)
end

local REASONS = {}
REASONS[200] = "OK"
REASONS[302] = "Found"
REASONS[404] = "Not Found"
REASONS[405] = "Method Not Allowed"

local function respond(fd, status, ctype, body, extra)
    local head = "HTTP/1.1 " .. status .. " " .. REASONS[status] .. "\r\nContent-Type: " .. ctype ..
        "\r\nContent-Length: " .. len(body) .. "\r\nConnection: close\r\nCache-Control: no-cache\r\n" ..
            (extra or "") .. "\r\n"
    local _ = net.write(fd, head .. body, 10000)
end

-- The page for one request path (and query), as {status, body}.
local function route(target)
    local q = nil
    local p = target
    local qpos = string.find(target, "?")
    if qpos ~= nil then
        p = string.sub(target, 1, qpos - 1)
        q = string.sub(target, qpos + 1)
    end
    p = url_decode(p)
    out = []
    local mods = load_modules()
    local by_file = [=]
    for _, m in mods do by_file[m.file] = m end

    local res = {}
    res.status = 200
    if p == "/" then
        page_index(mods, "Sea documentation")
    elseif string.starts_with(p, "/m/") then
        local m = by_file[string.sub(p, 4)]
        if m == nil then
            res.status = 404
            page_not_found("No documented module " .. string.sub(p, 4))
        else
            page_module(m)
        end
    elseif string.starts_with(p, "/src/") then
        -- only the files the index lists: no other path of the disk is served
        local m = by_file[string.sub(p, 6)]
        local src = m ~= nil and fs.read(m.file) or nil
        if src == nil or is_error(src) then
            res.status = 404
            page_not_found("No source " .. string.sub(p, 6))
        else
            page_source(m, src)
        end
    elseif string.starts_with(p, "/builtin/") then
        local name = string.sub(p, 10)
        local known = false
        for _, b in BUILTINS do
            if b == name then known = true end
        end
        if known then
            page_module(builtin_module(name))
        else
            res.status = 404
            page_not_found("No built-in module " .. name)
        end
    elseif p == "/search" then
        local term = ""
        for _, kv in string.split(q or "", "&") do
            if string.starts_with(kv, "q=") then term = string.trim(url_decode(string.sub(kv, 3))) end
        end
        page_search(mods, term)
    else
        res.status = 404
        page_not_found(p)
    end
    res.body = string.join(out, "\n") .. "\n"
    return res
end

local function handle(fd)
    local req = stream.reader(fd, {timeout = 5000}):read_until("\r\n\r\n", 65536)
    if req == nil or is_error(req) then return end
    local m = re.match("^([A-Z]+) (\\S+) HTTP/", req)
    if m == nil then return end
    if m.groups[1] ~= "GET" and m.groups[1] ~= "HEAD" then
        respond(fd, 405, "text/plain", "only GET\n", "Allow: GET, HEAD\r\n")
        return
    end
    local r = route(m.groups[2])
    respond(fd, r.status, "text/html; charset=utf-8", m.groups[1] == "HEAD" and "" or r.body)
end

local function serve(addr)
    local host = "127.0.0.1"
    local port_text = addr
    local colon = nil
    for k = len(addr), 1, -1 do
        if colon == nil and string.sub(addr, k, k) == ":" then colon = k end
    end
    if colon ~= nil then
        port_text = string.sub(addr, colon + 1)
        if colon > 1 then host = string.sub(addr, 1, colon - 1) end
    end
    local port = tonumber(port_text)
    if port == nil then
        io.write_err("sea doc: -http wants [host]:port, got " .. addr .. "\n")
        os.exit(2)
    end
    module_href = function(mod) return "/m/" .. url_path(mod.file) end
    source_href = function(mod, line)
        return "/src/" .. url_path(mod.file) .. (line ~= nil and "#L" .. line or "")
    end
    local lfd = net.listen(port, host)
    if is_error(lfd) then
        io.write_err("sea doc: listen on " .. addr .. ": " .. lfd.message .. "\n")
        os.exit(1)
    end
    local shown = host == "0.0.0.0" and "localhost" or host
    local url = "http://" .. shown .. ":" .. net.local_port(lfd) .. "/"
    print("sea doc: serving " .. string.join(paths, " ") .. " at " .. url .. "  (Ctrl-C stops)")
    if open_browser then
        go (function()
            local r = process.run({"xdg-open", url})
            if is_error(r) or not r.ok then io.write_err("sea doc: could not open a browser; visit " .. url .. "\n") end
        end)()
    end
    -- one request at a time: the pages are built in the shared output buffer
    while true do
        local fd = net.accept(lfd)
        if not is_error(fd) then
            handle(fd)
            net.close(fd)
        end
    end
end

if http_addr ~= nil then
    serve(http_addr)
end

-- ---- one shot ----------------------------------------------------------------------------------

local mods = []
if builtin ~= nil then
    mods[] = builtin_module(builtin)
else
    mods = load_modules()
end

-- only the entries matching a name
if filter ~= nil then
    local kept = []
    for _, mod in mods do
        local es = []
        for _, e in mod.entries do
            if e.name == filter or string.ends_with(e.name, "." .. filter) or string.ends_with(e.name, ":" .. filter) then
                es[] = e
            end
        end
        if len(es) > 0 then
            mod.entries = es
            mod.doc = ""
            kept[] = mod
        end
    end
    mods = kept
    if len(mods) == 0 then
        -- a bare function name (sea doc split): look in the built-in modules
        for _, b in BUILTINS do
            local bm = builtin_module(b)
            local es = []
            for _, e in bm.entries do
                if string.ends_with(e.name, "." .. filter) then es[] = e end
            end
            if len(es) > 0 then
                bm.entries = es
                bm.doc = ""
                mods[] = bm
            end
        end
    end
    if len(mods) == 0 then
        print("sea doc: nothing named " .. filter)
        os.exit(1)
    end
end

if len(mods) == 0 then
    print("sea doc: no documented Sea code found")
    os.exit(1)
end

if format == "markdown" then
    render_markdown(mods)
elseif format == "html" then
    render_html(mods)
elseif format == "json" then
    render_json(mods)
else
    render_text(mods)
end

local text = string.join(out, "\n") .. "\n"
if outfile ~= nil then
    local w = fs.write(outfile, text)
    if is_error(w) then
        print("sea doc: " .. w.message)
        os.exit(2)
    end
else
    io.write(text)
end
