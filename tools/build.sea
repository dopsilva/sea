-- sea build — make a standalone executable of a Sea program
--
--   sea build [-o out] [-i path ...] file.sea
--
-- The executable is a copy of this sea binary with the program appended: the
-- main file and every module it requires with a literal name, followed
-- recursively (.sea sources and native .so libraries). Built-in modules need
-- nothing. A require with a computed name cannot be followed: add those files
-- with -i. Files the program reads at run time (templates, data) are not
-- included.
--
--   -o out    the executable (default: the package name from sea.toml next to
--             the main file, else the main file's name without .sea)
--   -i path   also include this module (.sea or .so; may repeat)
--   -v        list the files included

local parser = require("sea/parser")

local flags = require("sea/flags")

local cli = flags.new("sea build", {
    long = "-",
    usage = "[-o out] [-i path ...] [-v] file.sea",
    about = "Makes a standalone executable: this sea binary with the program and the\n" ..
        "modules it requires (followed from require(\"...\") calls) appended.",
})
local out_flag = cli:string("o", "", "the executable (default: the package or file name)", {arg = "file"})
local include_flag = cli:list("i", "also include this module (for a computed require; may repeat)", {arg = "path"})
local verbose_flag = cli:bool("v", false, "list the files included")
local positional = cli:parse()

local out = out_flag.set and out_flag.value or nil
local includes = include_flag.value
local verbose = verbose_flag.value
local main = positional[0]
if len(positional) > 1 then
    io.write_err("sea build: one main file expected (got " .. positional[0] .. " and " .. positional[1] .. ")\n")
    os.exit(2)
end
if main == nil then
    cli:usage(true)
    os.exit(2)
end
if not fs.isfile(main) then
    io.write_err("sea build: " .. main .. ": no such file\n")
    os.exit(2)
end
-- the default name: the package's (sea.toml next to the main file), else the file's
local function package_name(dir)
    local toml = fs.read(path.join(dir, "sea.toml"))
    if is_error(toml) then return nil end
    local in_package = false
    for _, l in string.split(toml, "\n") do
        l = string.trim(l)
        if string.starts_with(l, "[") then in_package = l == "[package]" end
        local m = in_package and re.match("^name\\s*=\\s*\"([^\"]+)\"", l) or nil
        if m ~= nil then return m.groups[1] end
    end
    return nil
end
if out == nil then out = package_name(path.dirname(main)) or path.basename(main, ".sea") end

local builtin = {}
for _, g in parser.globals() do builtin[g] = true end
builtin["sea/parser"] = true
builtin["sea/test"] = true
builtin["sea/check"] = true
builtin["sea/stream"] = true
builtin["sea/flags"] = true
builtin["sea/log"] = true
builtin["sea/dotenv"] = true

-- The libraries installed with the sea binary (make install): lib/sea next to
-- its bin/ directory, or libs/ of the source tree it runs from, as require
-- looks; nil when there is none
local function sea_libdir()
    local exe = os.executable()
    if is_error(exe) then return nil end
    local top = path.dirname(path.dirname(exe))
    local d = path.join(top, "lib", "sea")
    if fs.isdir(d) then return d end
    if fs.isfile(path.join(top, "src", "sea_main.c")) and fs.isdir(path.join(top, "libs")) then
        return path.join(top, "libs")
    end
    return nil
end

-- Where require(name) from a file in dir finds its module (as the VM looks)
local function resolve(name, dir)
    local function try(base)
        for _, ext in {".sea", "/init.sea", ".so"} do
            if fs.isfile(base .. ext) then return path.normalize(path.abs(base .. ext)) end
        end
        return nil
    end
    if path.isabs(name) then return try(name) end
    local found = try(path.join(dir, name)) or try(name)
    -- a package from `sea get`: sea_modules/ here or above
    if found == nil and not string.starts_with(name, ".") then
        local d = path.normalize(path.abs(dir))
        while found == nil do
            local mods = path.join(d, "sea_modules")
            if fs.isdir(mods) then
                found = try(path.join(mods, name))
                local own = path.join(mods, name, path.basename(name) .. ".sea")
                if found == nil and fs.isfile(own) then found = path.normalize(path.abs(own)) end
            end
            if d == "/" then break end
            d = path.dirname(d)
        end
    end
    if found == nil then
        local sp = os.getenv("SEA_PATH")
        if sp ~= nil then
            for _, d in string.split(sp, ":") do
                if found == nil and d ~= "" then found = try(path.join(d, name)) end
            end
        end
    end
    local lib = sea_libdir()
    if found == nil and lib ~= nil and not string.starts_with(name, ".") then
        found = try(path.join(lib, name))
        local own = path.join(lib, name, path.basename(name))
        for _, ext in {".sea", ".so"} do
            if found == nil and fs.isfile(own .. ext) then found = path.normalize(own .. ext) end
        end
    end
    return found
end

local cwd = path.abs(".")

-- a path for messages: relative to the working directory
local function show(abs)
    local r = path.relative(cwd, abs)
    return is_error(r) and abs or r
end

local files = [] -- absolute paths, main first
local seen = {}
local problems = 0

local function add(abs)
    if seen[abs] then return false end
    seen[abs] = true
    files[] = abs
    return true
end

-- Follow the literal requires of a source file
local function follow(abs)
    local ast = parser.parse_file(abs)
    if is_error(ast) then
        io.write_err(ast.message .. "\n")
        problems = problems + 1
        return
    end
    local dir = path.dirname(abs)
    parser.walk(ast, function(n)
        if n.type == "call" and n.callee.type == "ident" and n.callee.name == "require" then
            local arg = n.args[0]
            if arg ~= nil and arg.type == "string" then
                local name = arg.value
                if not builtin[name] then
                    local found = resolve(name, dir)
                    if found == nil then
                        io.write_err(string.format("sea build: %s:%d: module '%s' not found\n", show(abs), n.line, name))
                        problems = problems + 1
                    elseif add(found) and path.ext(found) == ".sea" then
                        follow(found)
                    end
                end
            else
                io.write_err(string.format("sea build: note: %s:%d: require with a computed name is not followed (add the files with -i)\n",
                    show(abs), n.line))
            end
        end
    end)
end

local main_abs = path.normalize(path.abs(main))
add(main_abs)
follow(main_abs)
for _, inc in includes do
    if not fs.isfile(inc) then
        io.write_err("sea build: " .. inc .. ": no such file\n")
        os.exit(2)
    end
    local abs = path.normalize(path.abs(inc))
    if add(abs) and path.ext(abs) == ".sea" then follow(abs) end
end
if problems > 0 then os.exit(1) end

-- Paths in the bundle are relative to the deepest directory holding them all
local root = path.dirname(main_abs)
for _, f in files do
    while not string.starts_with(f, root == "/" and "/" or (root .. "/")) do root = path.dirname(root) end
end

local payload = []
local n_native = 0
for _, f in files do
    local data = fs.read(f)
    if is_error(data) then
        io.write_err("sea build: " .. data.message .. "\n")
        os.exit(1)
    end
    local rel = path.relative(root, f)
    local kind = path.ext(f) == ".so" and "N" or "S"
    if kind == "N" then n_native = n_native + 1 end
    if verbose then print(string.format("  %s  %s", kind == "N" and "native" or "source", rel)) end
    payload[] = string.format("%s %d %s\n", kind, len(data), rel)
    payload[] = data
end
payload[] = "E\n"

-- This binary, without a bundle of its own
local exe = fs.read(os.executable())
if is_error(exe) then
    io.write_err("sea build: cannot read the sea binary: " .. exe.message .. "\n")
    os.exit(1)
end
local tail = string.sub(exe, len(exe) - 27)
if string.sub(tail, 21) == "SEABNDL1" then exe = string.sub(exe, 1, tonumber(string.sub(tail, 1, 20))) end

local body = string.join(payload, "")
local trailer = string.format("%020d", len(exe)) .. "SEABNDL1"
if fs.exists(out) then fs.remove(out) end
local opts = {}
opts.mode = 493 -- 0755
local w = fs.write(out, exe .. body .. trailer, opts)
if is_error(w) then
    io.write_err("sea build: " .. w.message .. "\n")
    os.exit(1)
end
local what = tostring(len(files)) .. (len(files) == 1 and " file" or " files")
if n_native > 0 then what = what .. " (" .. tostring(n_native) .. " native)" end
local size = len(exe) + len(body) + len(trailer)
print(string.format("%s: %s, %.1f MB", out, what, size / 1048576))
